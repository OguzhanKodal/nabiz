{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nabız",
  "mainBinaryName": "nabiz",
  "version": "0.1.0",
  "identifier": "io.github.oguzhankodal.nabiz",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nabız",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Legion laptop kontrol merkezi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/polkit-1/actions/io.github.oguzhankodal.nabiz.policy": "../packaging/io.github.oguzhankodal.nabiz.policy"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/polkit-1/actions/io.github.oguzhankodal.nabiz.policy": "../packaging/io.github.oguzhankodal.nabiz.policy"
        }
      }
    }
  }
}
